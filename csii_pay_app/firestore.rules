rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────
    // CSII-PAY USER PROFILES
    // ─────────────────────────────────────────────────────────────────
    match /users/{username} {
      // Allow reading student profiles to look up nicknames and verify usernames
      allow read: if true;
      // Allow writing student profiles without password
      allow create, update: if true;
    }

    // ─────────────────────────────────────────────────────────────────
    // CSII-PAY NETWORK CONFIG (Cloudflare Gateway discovery)
    // ─────────────────────────────────────────────────────────────────
    match /network_config/{docId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────────
    // CSII-PAY MARKETPLACE APPLICATIONS
    // ─────────────────────────────────────────────────────────────────
    match /marketplace_applications/{appId} {
      // Allow reading applications for marketplace browsing
      allow read: if true;
      // Allow creating and updating applications
      allow create, update: if true;
    }

    // ─────────────────────────────────────────────────────────────────
    // USERS (Existing App)
    // ─────────────────────────────────────────────────────────────────
    match /Users/{userId} {
      // Any authenticated user can read public profile fields 
      allow read: if request.auth != null;
      
      // Only the user themselves can write their own profile
      allow write: if request.auth != null && request.auth.uid == userId;

      // Call logs sub-collection
      match /CallLogs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─────────────────────────────────────────────────────────────────
    // DIRECT MESSAGES (chat_rooms)
    // ─────────────────────────────────────────────────────────────────
    match /chat_rooms/{roomId} {
      allow read, write: if request.auth != null 
                         && request.auth.uid in resource.data.participants;
                         
      allow create: if request.auth != null 
                    && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read, write: if request.auth != null 
                           && request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants;
      }
    }

    // ─────────────────────────────────────────────────────────────────
    // GROUP CHATS (group_rooms)
    // ─────────────────────────────────────────────────────────────────
    match /group_rooms/{groupId} {
      allow read, update: if request.auth != null 
                          && request.auth.uid in resource.data.memberUIDs;
                          
      allow create: if request.auth != null 
                    && request.auth.uid in request.resource.data.memberUIDs 
                    && request.resource.data.adminUID == request.auth.uid;
                    
      allow delete: if request.auth != null 
                    && resource.data.adminUID == request.auth.uid;

      match /messages/{messageId} {
        allow read, write: if request.auth != null 
                           && request.auth.uid in get(/databases/$(database)/documents/group_rooms/$(groupId)).data.memberUIDs;
      }
    }

    // ─────────────────────────────────────────────────────────────────
    // DENY EVERYTHING ELSE
    // ─────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
