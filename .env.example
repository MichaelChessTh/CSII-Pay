# CSII-Pay node secrets. Copy to .env and fill in real values.
# Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit .env (it is listed in .gitignore and .dockerignore).

# Password of the Student Council / genesis account (6958082456).
# Every node on the same chain must use the same value: the council key pair is
# derived from it, and changing it means starting a new chain.
CSII_GENESIS_PASSWORD=

# Shared HMAC secret for signing access and refresh tokens (JWT HS256).
# Every node in the deployment must use the same value. Minimum 32 characters.
CSII_JWT_SECRET=

# Comma-separated browser origins allowed to call the API (CORS).
# Example: https://pay.example.edu,http://localhost:8080
# Leave empty during local development to allow any origin (a warning is printed).
CSII_ALLOWED_ORIGINS=

# Set to 1 only when the gateway sits behind a TLS terminator (Cloudflare Tunnel).
CSII_GATEWAY_TLS_TERMINATED=0

# Optional: operator account for a non-genesis node (instead of --account/--password flags).
# CSII_OPERATOR_ACCOUNT=
# CSII_OPERATOR_PASSWORD=
